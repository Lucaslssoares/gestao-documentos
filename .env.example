# =============================================================================
# Gestão de Documentos — variáveis de ambiente
# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o Git.
# =============================================================================

# ---- Supabase (Auth + Postgres/pgvector + função de embeddings) ----
# Local: rode `npx supabase start` e copie os valores de `npx supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=cole-a-anon-key-aqui
# Use a chave service_role (JWT). Fica só no servidor — nunca no front-end.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui
# Quando o backend roda no Docker e o Supabase local roda no host:
SUPABASE_URL_DOCKER=http://host.docker.internal:54321

# ---- Front-end (públicas: vão para o navegador) ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# ---- Armazenamento de arquivos (MinIO / S3) ----
# Conta administrativa do MinIO (só o container de inicialização usa).
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=troque-esta-senha-admin
# Usuário da aplicação, criado automaticamente com acesso só ao bucket abaixo.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gestao-documentos
S3_ACCESS_KEY=gestao-documentos-app
S3_SECRET_KEY=troque-esta-chave-da-aplicacao
UPLOAD_MAX_MB=25

# ---- Assistente de IA (Claude) ----
# Sem a chave, o sistema funciona normalmente e só o assistente fica indisponível.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Backend ----
PORT=3333
LOG_LEVEL=info
# URL do front-end (links de convite e de redefinição de senha)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Porta do front-end no Docker (mude se a 8080 estiver ocupada)
FRONTEND_PORT=8080

# ---- Deploy (servidor) ----
# Dono das imagens no GitHub Container Registry (usuário ou organização do repositório)
GHCR_OWNER=local
IMAGE_TAG=latest
